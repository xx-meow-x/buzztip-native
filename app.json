{
  "expo": {
    "name": "BuzzTip",
    "slug": "buzztip",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "buzztip",
    "ios": { "supportsTablet": false, "bundleIdentifier": "ph.edu.tip.buzztip" },
    "android": { "package": "ph.edu.tip.buzztip" },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": [
      ["expo-image-picker", { "photosPermission": "BuzzTip needs your photos so you can add pictures to listings and your profile." }]
    ]
  }
}
